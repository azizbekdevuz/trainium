{
  "name": "trainium",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.0.6",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "pnpm": {
    "overrides": {
      "tar": "^7.5.21",
      "socket.io>engine.io": "6.6.11",
      "socket.io-client>engine.io-client": "6.6.6",
      "socket.io>socket.io-adapter": "2.5.8",
      "socket.io-parser": "4.2.7",
      "effect": "^3.20.0",
      "qs": "^6.16.1",
      "proxy-addr": "2.0.8",
      "minimatch@^3.0.0": "3.1.5",
      "@typescript-eslint/typescript-estree@8.57.2>minimatch": "10.2.6",
      "minimatch@3.1.5>brace-expansion": "1.1.21",
      "eslint@9.39.4>@humanfs/node": "0.16.8",
      "postcss@8.4.31>nanoid": "3.3.18",
      "picomatch@^2.0.0": "2.3.2",
      "picomatch@^4.0.0": "4.0.4",
      "flatted@^3.0.0": "3.4.2",
      "path-to-regexp@0.1.12": "0.1.13",
      "path-to-regexp@8.2.0": "8.4.1",
      "defu": "^6.1.5"
    }
  },
  "scripts": {
    "dev": "turbo run dev --parallel",
    "dev:web": "pnpm --filter @apps/web dev",
    "dev:socket": "pnpm --filter @apps/socket dev",
    "build": "turbo run build",
    "start": "turbo run start --parallel",
    "start:web": "pnpm --filter @apps/web start",
    "start:socket": "pnpm --filter @apps/socket start",
    "lint": "eslint . --ext .ts,.tsx,.js,.mjs",
    "lint:fix": "eslint . --ext .ts,.tsx,.js,.mjs --fix",
    "lint:apps": "turbo run lint",
    "typecheck": "turbo run typecheck"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@eslint/js": "^9.39.4",
    "@prisma/client": "7.10.1",
    "@typescript-eslint/eslint-plugin": "^8.57.2",
    "@typescript-eslint/parser": "^8.57.2",
    "dotenv": "^16.4.7",
    "eslint": "^9.39.4",
    "eslint-config-next": "15.5.29",
    "prisma": "7.10.1",
    "turbo": "~2.9.14",
    "typescript-eslint": "^8.57.2"
  }
}
